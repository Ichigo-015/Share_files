<Window x:Class="Share_files.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Share_files"
        mc:Ignorable="d"
        Title="Share Files - P2P ファイル共有" Height="560" Width="900"
        MinHeight="480" MinWidth="760"
        Background="#FFEFF3F8"
        FontFamily="Yu Gothic UI" FontSize="13">

    <Window.Resources>
        <!-- 見出し -->
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF2C3E50" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 共通ボタン -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3498DB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FFB9C4CE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#FF27AE60" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#FFE74C3C" />
        </Style>
        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#FF7F8C9A" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="BorderBrush" Value="#FFCBD5DE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#FFE1E8EF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ListLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF7F8C9A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#FF2C3E50" CornerRadius="10" Padding="18,12" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="Share Files" FontSize="20" FontWeight="Bold" Foreground="White"
                           DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBlock Text="同一ネットワーク上の相手と直接ファイルを送受信できます"
                           Foreground="#FFAEBECD" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- 本体: 送信(左) / 受信(右) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 送信パネル ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📤 送信" Style="{StaticResource PanelHeader}" />

                    <!-- 接続先 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="68" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="相手の IP" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" x:Name="Ftp_Server_IP" FontFamily="Consolas"
                                 ToolTip="接続先の IP アドレス (例: 192.168.1.10)" />
                        <TextBlock Grid.Column="2" Text="ポート" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Grid.Column="3" x:Name="ConnectPort" FontFamily="Consolas" Text="1145" />
                    </Grid>

                    <!-- 接続 / 切断 -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnConnect" Content="接続"
                                Style="{StaticResource FlatButton}" Click="btnConnect_Click" />
                        <Button Grid.Column="2" x:Name="btnClose" Content="切断"
                                Style="{StaticResource NeutralButton}" Click="btnClose_Click" IsEnabled="False" />
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="Connection_Statement" Text="未接続"
                               FontFamily="Consolas" Foreground="#FF95A5A6" Margin="0,8,0,0" />

                    <!-- 選択ファイル一覧 -->
                    <DockPanel Grid.Row="4" Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="選択中のファイル" Style="{StaticResource ListLabel}" />
                        <ListBox x:Name="SelectedFilesList" />
                    </DockPanel>

                    <!-- 選択 / 送信 -->
                    <Grid Grid.Row="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnSelect" Content="ファイルを選択"
                                Style="{StaticResource NeutralButton}" Click="btnSelect_Click" />
                        <Button Grid.Column="2" x:Name="btnUpload" Content="送信"
                                Style="{StaticResource SuccessButton}" Click="btnUpload_Click" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 受信パネル ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📥 受信" Style="{StaticResource PanelHeader}" />

                    <!-- 待ち受け -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="待ち受けポート" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" x:Name="ListenPort" FontFamily="Consolas" Text="1145" />
                        <Button Grid.Column="3" x:Name="btnListen" Content="待ち受け開始"
                                Style="{StaticResource FlatButton}" Click="btnListen_Click" />
                    </Grid>

                    <TextBlock Grid.Row="2" x:Name="Listen_Statement" Text="停止中"
                               FontFamily="Consolas" Foreground="#FF95A5A6" Margin="0,8,0,0" />

                    <!-- 保存先 -->
                    <TextBlock Grid.Row="3" Text="保存先フォルダ" Style="{StaticResource ListLabel}" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SaveFileTo" IsReadOnly="True"
                                 FontFamily="Consolas" Background="#FFF4F7FA" />
                        <Button Grid.Column="2" x:Name="btnSaveTo" Content="変更"
                                Style="{StaticResource NeutralButton}" Click="btnSaveTo_Click" />
                    </Grid>

                    <!-- 受信ファイル一覧 -->
                    <DockPanel Grid.Row="5" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock Text="受信したファイル" Style="{StaticResource ListLabel}" DockPanel.Dock="Left" />
                            <Button x:Name="btnOpenFolder" Content="フォルダを開く" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right" Background="Transparent" Foreground="#FF3498DB"
                                    BorderThickness="0" Cursor="Hand" Padding="4,0" Click="btnOpenFolder_Click" />
                        </DockPanel>
                        <ListBox x:Name="ReceivedFilesList" MouseDoubleClick="ReceivedFilesList_MouseDoubleClick" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- フッター: 進捗 + ステータス -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="準備完了"
                           VerticalAlignment="Center" Foreground="#FF55606B" />
                <ProgressBar Grid.Column="1" x:Name="TransferProgress" Height="14"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#FF27AE60" Background="#FFE7ECF1" BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
